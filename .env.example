# Variables del frontend. En Vercel: Settings → Environment Variables.
# El build (scripts/generar-config.mjs) las escribe en public/js/config.js.

# URL base de los webhooks de producción de n8n, sin barra final.
# Ejemplo: https://tu-instancia.app.n8n.cloud/webhook
EP_N8N_BASE_URL=

# URL del Chat Trigger de WF10 (en n8n: nodo "Chat Trigger" → Chat URL).
# Ejemplo: https://tu-instancia.app.n8n.cloud/webhook/<id>/chat
EP_CHAT_URL=

# Usuario del bot de Telegram, sin @. Ejemplo: EventPassBot
EP_TELEGRAM_BOT=
