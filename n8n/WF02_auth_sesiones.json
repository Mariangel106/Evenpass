      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\nconst b = $input.first().json.body || {};\nconst accion = norm(b.accion).toLowerCase();\nif (!['login', 'logout', 'validar'].includes(accion)) return fallo(400, 'Operación no soportada. Usa login, logout o validar.');\nconst datos = { ok: true, accion, email: normEmail(b.email), password: String(b.password ?? ''), session_token: norm(b.session_token) };\nif (accion === 'login' && (!datos.email || !datos.password)) return fallo(400, 'Escribe tu correo y tu contraseña.');\nif (accion !== 'login' && !datos.session_token) return fallo(401, 'Falta el token de sesión.');\nreturn [{ json: datos }];\n"
      },
