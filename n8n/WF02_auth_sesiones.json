    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\n// --- Hashing de contraseñas (SHA-256 iterado con salt) -------------------\n// Implementación en JS puro para que funcione aunque n8n no permita require('crypto').\nfunction sha256(texto) {\n  const utf8 = unescape(encodeURIComponent(texto));\n  const K = [];\n  const H = [];\n  let primo = 2;\n  const esPrimo = (n) => { for (let d = 2; d * d <= n; d++) if (n % d === 0) return false; return true; };\n  const frac = (x) => ((x - Math.floor(x)) * 0x100000000) | 0;\n  while (K.length < 64) {\n    if (esPrimo(primo)) {\n      if (H.length < 8) H.push(frac(Math.pow(primo, 1 / 2)));\n      K.push(frac(Math.pow(primo, 1 / 3)));\n    }\n    primo++;\n  }\n  const bytes = [];\n  for (let i = 0; i < utf8.length; i++) bytes.push(utf8.charCodeAt(i));\n  const bitLen = bytes.length * 8;\n  bytes.push(0x80);\n  while (bytes.length % 64 !== 56) bytes.push(0);\n  for (let i = 7; i >= 0; i--) bytes.push(i >= 4 ? 0 : (bitLen >>> (i * 8)) & 0xff);\n  const rotr = (x, n) => (x >>> n) | (x << (32 - n));\n  const w = new Array(64);\n  for (let off = 0; off < bytes.length; off += 64) {\n    for (let i = 0; i < 16; i++) {\n      w[i] = (bytes[off + i * 4] << 24) | (bytes[off + i * 4 + 1] << 16) | (bytes[off + i * 4 + 2] << 8) | bytes[off + i * 4 + 3];\n    }\n    for (let i = 16; i < 64; i++) {\n      const s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >>> 3);\n      const s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >>> 10);\n      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0;\n    }\n    let [a, b, c, d, e, f, g, h] = H;\n    for (let i = 0; i < 64; i++) {\n      const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);\n      const t1 = (h + S1 + ((e & f) ^ (~e & g)) + K[i] + w[i]) | 0;\n      const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);\n      const t2 = (S0 + ((a & b) ^ (a & c) ^ (b & c))) | 0;\n      h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;\n    }\n    H[0] = (H[0] + a) | 0; H[1] = (H[1] + b) | 0; H[2] = (H[2] + c) | 0; H[3] = (H[3] + d) | 0;\n    H[4] = (H[4] + e) | 0; H[5] = (H[5] + f) | 0; H[6] = (H[6] + g) | 0; H[7] = (H[7] + h) | 0;\n  }\n  return H.map((x) => (x >>> 0).toString(16).padStart(8, '0')).join('');\n}\n\nconst ITERACIONES_HASH = 5000;\n\nfunction hashPassword(password, salt) {\n  let hash = sha256(salt + ':' + password);\n  for (let i = 1; i < ITERACIONES_HASH; i++) hash = sha256(hash + salt);\n  return hash;\n}\n\nfunction hexAleatorio(bytes) {\n  try {\n    return require('crypto').randomBytes(bytes).toString('hex');\n  } catch (e) {\n    let s = '';\n    for (let i = 0; i < bytes * 2; i++) s += Math.floor(Math.random() * 16).toString(16);\n    return s;\n  }\n}\n\n// Comparación en tiempo constante para no filtrar información por tiempos.\nfunction igualesSeguro(a, b) {\n  if (typeof a !== 'string' || typeof b !== 'string' || a.length !== b.length) return false;\n  let r = 0;\n  for (let i = 0; i < a.length; i++) r |= a.charCodeAt(i) ^ b.charCodeAt(i);\n  return r === 0;\n}\nconst d = $('Validar solicitud').first().json;\nconst u = filas('Leer Usuarios').find((r) => r.email_normalizado === d.email);\n// Mismo mensaje para correo inexistente y contraseña incorrecta: no revela qué cuentas existen.\nconst credencialesInvalidas = () => fallo(401, 'Correo o contraseña incorrectos.');\nif (!u) return credencialesInvalidas();\nif (!igualesSeguro(hashPassword(d.password, u.password_salt), u.password_hash)) return credencialesInvalidas();\nif (u.estado !== 'ACTIVO') return fallo(403, 'Esta cuenta está inactiva.');\nreturn [{ json: { ok: true, usuario_id: u.usuario_id, nombre: u.nombre, email: u.email_normalizado } }];\n"
      },
