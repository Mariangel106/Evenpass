    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\nconst d = $('Validar solicitud').first().json;\nconst s = filas('Leer Sesiones').find((r) => r.session_token === d.session_token);\nconst invalida = (status, error) => [{ json: { resultado: 'INVALIDA', status, body: { ok: false, valida: false, error } } }];\nif (!s) return invalida(401, 'La sesión no existe.');\nif (s.estado !== 'ACTIVA') return invalida(401, 'La sesión está ' + s.estado.toLowerCase() + '.');\nif (new Date(s.expira_en).getTime() <= Date.now()) {\n  return [{ json: { resultado: 'EXPIRADA', session_id: s.session_id, estado: 'EXPIRADA', status: 401,\n    body: { ok: false, valida: false, error: 'Tu sesión expiró. Inicia sesión de nuevo.' } } }];\n}\nconst u = filas('Leer Usuarios').find((r) => r.usuario_id === s.usuario_id);\nif (!u || u.estado !== 'ACTIVO') return invalida(403, 'Esta cuenta está inactiva.');\nreturn [{ json: { resultado: 'VALIDA', session_id: s.session_id, ultima_validacion: ahora(), status: 200,\n  body: { ok: true, valida: true, expira_en: s.expira_en, usuario: { usuario_id: u.usuario_id, nombre: u.nombre, email: u.email_normalizado } } } }];\n"
      },
