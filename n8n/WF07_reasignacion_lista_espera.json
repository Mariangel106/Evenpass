        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\nreturn $input.all().map(({ json: r }) => ({ json: {\n  reasignacion_id: nuevoId('REA'),\n  evento_id: r.meta.evento_id,\n  inscripcion_id: r.meta.inscripcion_id,\n  usuario_id: r.meta.usuario_id,\n  fecha: ahora(),\n  orden_lista: r.meta.orden_lista,\n  estado_anterior: 'LISTA_ESPERA',\n  estado_nuevo: 'CONFIRMADA',\n  resultado_notificacion: `gmail=${r.gmail_estado}; telegram=${r.telegram_estado}`,\n} }));\n"
