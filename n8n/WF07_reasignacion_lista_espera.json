      "id": "fa136290-77a2-5563-87ad-30f704d9657a",
      "name": "Leer Inscripciones",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1040,
        0
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
