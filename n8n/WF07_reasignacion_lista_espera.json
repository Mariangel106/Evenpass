      "id": "620df531-d080-5f56-9857-79f59922ffd1",
      "name": "Ordenar lista de espera",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [
        1560,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\n// Lista ya ordenada por evento y fecha_inscripcion ASC: el que más lleva esperando va primero.\nconst porEvento = {};\nconst promovidos = [];\nfor (const { json: i } of $input.all()) {\n  const orden = (porEvento[i.evento_id] = (porEvento[i.evento_id] || 0) + 1);\n  if (orden > i.cupos_libres) continue; // permanece en LISTA_ESPERA\n  const fecha = ahora();\n  promovidos.push({ json: {\n    inscripcion_id: i.inscripcion_id,\n    usuario_id: i.usuario_id,\n    evento_id: i.evento_id,\n    estado: 'CONFIRMADA',\n    orden_espera: '',\n    fecha_actualizacion: fecha,\n    orden_lista: String(orden),\n    notificacion: {\n      usuario_id: i.usuario_id, evento_id: i.evento_id, inscripcion_id: i.inscripcion_id,\n      tipo: 'REASIGNACION_CUPO', titulo: `Se liberó un cupo para ti: ${i.evento_nombre}`,\n      mensaje: `Pasaste de la lista de espera a inscripción CONFIRMADA. Te esperamos el ${i.evento_cuando} en ${i.evento_lugar}.`,\n      clave_idempotencia: `REASIGNACION_CUPO|${i.inscripcion_id}`,\n    },\n  } });\n}\nreturn promovidos;\n"
      },
