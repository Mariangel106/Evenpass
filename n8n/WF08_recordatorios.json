    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\n// --- Utilidades de eventos e inscripciones ------------------------------\nconst ZONA_HORARIA = '-05:00'; // Hora de Colombia\nfunction inicioEvento(evento) {\n  const [h = '00', m = '00'] = norm(evento.hora).split(':');\n  return new Date(`${norm(evento.fecha)}T${h.padStart(2, '0')}:${m.padStart(2, '0')}:00${ZONA_HORARIA}`);\n}\nconst ESTADOS_ACTIVOS = ['CONFIRMADA', 'LISTA_ESPERA'];\nfunction confirmadasDe(inscripciones, eventoId) {\n  return inscripciones.filter((i) => i.evento_id === eventoId && i.estado === 'CONFIRMADA').length;\n}\nfunction listaEsperaDe(inscripciones, eventoId) {\n  return inscripciones\n    .filter((i) => i.evento_id === eventoId && i.estado === 'LISTA_ESPERA')\n    .sort((a, b) => norm(a.fecha_inscripcion).localeCompare(norm(b.fecha_inscripcion)));\n}\nconst fechaLegible = (evento) => {\n  const d = inicioEvento(evento);\n  if (isNaN(d)) return `${evento.fecha} ${evento.hora}`;\n  return d.toLocaleString('es-CO', {\n    timeZone: 'America/Bogota', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',\n  });\n};\nconst TIPOS = [\n  { tipo: 'RECORDATORIO_2H', horas: 2, texto: 'empieza en menos de 2 horas' },\n  { tipo: 'RECORDATORIO_24H', horas: 24, texto: 'es mañana' },\n];\nconst eventos = ($('Agrupar eventos').first().json.eventos || []).filter((e) => e && e.evento_id);\nconst inscripciones = filas('Leer Inscripciones');\nconst usuarios = Object.fromEntries(filas('Leer Usuarios').map((u) => [u.usuario_id, u]));\n// Control de duplicados: claves ya ENVIADAS u OMITIDAS no se vuelven a procesar (ERROR sí se reintenta).\nconst cerradas = new Set(filas('Leer Recordatorios').filter((r) => ['ENVIADO', 'OMITIDO'].includes(r.estado)).map((r) => r.clave_idempotencia));\nconst ahoraMs = Date.now();\nconst salida = [];\nfor (const e of eventos) {\n  const inicio = inicioEvento(e);\n  const faltanH = (inicio.getTime() - ahoraMs) / 3600000;\n  if (faltanH <= 0) continue;\n  // Solo el recordatorio más cercano que aplique: si faltan 90 min se envía el de 2 h, no el de 24 h.\n  const t = TIPOS.find((x) => faltanH <= x.horas);\n  if (!t) continue;\n  for (const i of inscripciones.filter((x) => x.evento_id === e.evento_id && x.estado === 'CONFIRMADA')) {\n    const clave = `${i.usuario_id}|${e.evento_id}|${t.tipo}`;\n    if (cerradas.has(clave)) continue;\n    const activo = usuarios[i.usuario_id]?.estado === 'ACTIVO';\n    salida.push({ json: {\n      enviar: activo,\n      recordatorio: {\n        recordatorio_id: nuevoId('REC'),\n        usuario_id: i.usuario_id,\n        evento_id: e.evento_id,\n        inscripcion_id: i.inscripcion_id,\n        tipo_recordatorio: t.tipo,\n        fecha_programada: new Date(inicio.getTime() - t.horas * 3600000).toISOString(),\n        fecha_envio: activo ? '' : ahora(),\n        estado: activo ? 'PENDIENTE' : 'OMITIDO',\n        clave_idempotencia: clave,\n      },\n      usuario_id: i.usuario_id, evento_id: e.evento_id, inscripcion_id: i.inscripcion_id,\n      tipo: t.tipo,\n      titulo: `Recordatorio: ${e.nombre} ${t.texto}`,\n      mensaje: `Tu evento es el ${fechaLegible(e)} en ${e.lugar}. Llega 30 minutos antes para la acreditación a nombre de ${i.nombre_acreditacion}.`,\n      clave_idempotencia: clave,\n    } });\n  }\n}\nreturn salida;\n"
      },
