    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\nconst n = $('Validar entrada').first().json;\nconst esc = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst u = filas('Leer Usuarios').find((x) => x.usuario_id === n.usuario_id);\nconst v = filas('Leer chat_id').find((x) => x.usuario_id === n.usuario_id && x.estado === 'ACTIVA');\n// Idempotencia: si esta clave ya se entregó por algún canal, no se repite.\nconst previa = filas('Leer Notificaciones').find((x) => x.clave_idempotencia === n.clave_idempotencia\n  && (x.gmail_estado === 'ENVIADO' || x.telegram_estado === 'ENVIADO'));\nconst email = u ? u.email_normalizado : '';\nconst chat_id = v ? String(v.chat_id) : '';\nconst html = `<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:560px;margin:auto;color:#14202b\">\n  <div style=\"background:#0d3b66;color:#fff;padding:18px 22px;border-radius:10px 10px 0 0;font-size:20px;font-weight:bold\">EventPass</div>\n  <div style=\"border:1px solid #d8e0e8;border-top:0;padding:22px;border-radius:0 0 10px 10px\">\n    <h2 style=\"margin:0 0 12px;font-size:19px\">${esc(n.titulo)}</h2>\n    <p style=\"font-size:15px;line-height:1.55;margin:0 0 14px\">Hola ${esc(u ? u.nombre : '')},</p>\n    <p style=\"font-size:15px;line-height:1.55;margin:0 0 18px\">${esc(n.mensaje)}</p>\n    <p style=\"font-size:12px;color:#5b6b7a;margin:0\">Referencia: ${esc(n.tipo)} · ${esc(n.inscripcion_id || n.evento_id)}</p>\n  </div></div>`;\nreturn [{ json: {\n  ...n,\n  duplicada: Boolean(previa),\n  email,\n  chat_id,\n  html,\n  telegram_texto: `<b>${esc(n.titulo)}</b>\\n\\n${esc(n.mensaje)}`,\n  gmail_estado: email ? 'PENDIENTE' : 'NO_APLICA',\n  telegram_estado: chat_id ? 'PENDIENTE' : 'NO_APLICA',\n  gmail_error: email ? '' : (u ? 'Usuario sin correo' : 'Usuario no encontrado'),\n  telegram_error: chat_id ? '' : 'Usuario sin Telegram vinculado',\n} }];\n"
      },
