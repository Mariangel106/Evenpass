        "jsCode": "const d = $('Resolver destinatarios').first().json;\nconst r = $input.first().json;\nlet estado = 'ENVIADO';\nlet error = '';\nif (!d.email) { estado = 'NO_APLICA'; error = d.gmail_error; }\nelse if (r.error) { estado = 'ERROR'; error = String(r.error.message || r.error).slice(0, 300); }\nreturn [{ json: { notificacion_id: d.notificacion_id, gmail_estado: estado, gmail_error: error } }];\n"
