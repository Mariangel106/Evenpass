    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fechaLegible = (iso) => new Date(iso).toLocaleString('es-CO', {\n  timeZone: 'America/Bogota', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',\n});\n// Fila de la hoja Checkins (EP11). Se registra en todos los intentos, no solo en los exitosos.\nconst registro = (d, resultado, detalle, usuario_id = '') => ({\n  checkin_id: nuevoId('CHK'), inscripcion_id: d.inscripcion_id || '', evento_id: d.evento_id || '', usuario_id,\n  fecha_checkin: ahora(), resultado, detalle,\n});\nconst a = $input.first().json;\nconst ins = a.inscripcion;\nconst evento = a.evento;\nconst fila = registro(a, 'EXITOSO', `CONFIRMADA → ASISTIO · ${ins.nombre_acreditacion || ins.usuario_id}`, ins.usuario_id);\nreturn [{ json: {\n  ...fila,\n  _inscripcion: { inscripcion_id: ins.inscripcion_id, estado: 'ASISTIO', fecha_actualizacion: fila.fecha_checkin },\n  _respuesta: {\n    ok: true, resultado: 'EXITOSO', mensaje: 'Check-in realizado correctamente.',\n    checkin: { checkin_id: fila.checkin_id, inscripcion_id: fila.inscripcion_id, evento_id: fila.evento_id, usuario_id: fila.usuario_id, fecha_checkin: fila.fecha_checkin },\n    inscripcion: { inscripcion_id: ins.inscripcion_id, estado_anterior: 'CONFIRMADA', estado: 'ASISTIO', nombre_acreditacion: ins.nombre_acreditacion },\n    evento: { evento_id: evento.evento_id, nombre: evento.nombre, fecha: evento.fecha, hora: evento.hora, lugar: evento.lugar },\n  },\n  _notificacion: {\n    usuario_id: ins.usuario_id, evento_id: evento.evento_id, inscripcion_id: ins.inscripcion_id,\n    tipo: 'CHECKIN_EXITOSO', titulo: `Ingreso registrado: ${evento.nombre}`,\n    mensaje: `Registramos tu ingreso a ${evento.nombre} (${evento.lugar}) el ${fechaLegible(fila.fecha_checkin)}. Código de check-in: ${fila.checkin_id}. ¡Que lo disfrutes!`,\n    clave_idempotencia: `CHECKIN_EXITOSO|${ins.inscripcion_id}`,\n  },\n} }];\n"
      },
