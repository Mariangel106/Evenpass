    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fechaLegible = (iso) => new Date(iso).toLocaleString('es-CO', {\n  timeZone: 'America/Bogota', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',\n});\n// Fila de la hoja Checkins (EP11). Se registra en todos los intentos, no solo en los exitosos.\nconst registro = (d, resultado, detalle, usuario_id = '') => ({\n  checkin_id: nuevoId('CHK'), inscripcion_id: d.inscripcion_id || '', evento_id: d.evento_id || '', usuario_id,\n  fecha_checkin: ahora(), resultado, detalle,\n});\n// Reúne lo leído de EP06, EP04 y EP11 y deja una bandera por cada validación.\n// Las decisiones las toman los nodos IF que siguen, en este orden.\nconst d = $('Validar solicitud').first().json;\nconst ins = filas('Leer Inscripciones').find((i) => norm(i.inscripcion_id).toUpperCase() === d.inscripcion_id) || null;\nconst evento = filas('Leer Eventos').find((e) => norm(e.evento_id).toUpperCase() === d.evento_id) || null;\nconst previo = filas('Leer historial de check-in')\n  .find((c) => norm(c.inscripcion_id).toUpperCase() === d.inscripcion_id && c.resultado === 'EXITOSO') || null;\nreturn [{ json: {\n  ...d,\n  inscripcion_existe: !!ins,\n  evento_existe: !!evento,\n  corresponde_evento: !!ins && norm(ins.evento_id).toUpperCase() === d.evento_id,\n  // Duplicado: ya hay un EXITOSO en Checkins o la inscripción ya quedó en ASISTIO.\n  checkin_previo: !!previo || (!!ins && ins.estado === 'ASISTIO'),\n  inscripcion_confirmada: !!ins && ins.estado === 'CONFIRMADA',\n  evento_vigente: !!evento && evento.estado !== 'CANCELADO',\n  inscripcion: ins,\n  evento,\n  previo,\n} }];\n"
      },
