    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\nconst normEmail = (v) => norm(v).toLowerCase();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fallo = (status, mensaje, extra = {}) => [{ json: { ok: false, status, body: { ok: false, error: mensaje }, ...extra } }];\n// --- Utilidades de eventos e inscripciones ------------------------------\nconst ZONA_HORARIA = '-05:00'; // Hora de Colombia\nfunction inicioEvento(evento) {\n  const [h = '00', m = '00'] = norm(evento.hora).split(':');\n  return new Date(`${norm(evento.fecha)}T${h.padStart(2, '0')}:${m.padStart(2, '0')}:00${ZONA_HORARIA}`);\n}\nconst ESTADOS_ACTIVOS = ['CONFIRMADA', 'LISTA_ESPERA'];\nfunction confirmadasDe(inscripciones, eventoId) {\n  return inscripciones.filter((i) => i.evento_id === eventoId && ['CONFIRMADA', 'ASISTIO'].includes(i.estado)).length;\n}\nfunction listaEsperaDe(inscripciones, eventoId) {\n  return inscripciones\n    .filter((i) => i.evento_id === eventoId && i.estado === 'LISTA_ESPERA')\n    .sort((a, b) => norm(a.fecha_inscripcion).localeCompare(norm(b.fecha_inscripcion)));\n}\nconst fechaLegible = (evento) => {\n  const d = inicioEvento(evento);\n  if (isNaN(d)) return `${evento.fecha} ${evento.hora}`;\n  return d.toLocaleString('es-CO', {\n    timeZone: 'America/Bogota', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',\n  });\n};\n// Llega un solo item desde la rama que decidió el resultado (EXITOSO, DUPLICADO o RECHAZADO).\nconst c = $input.first().json;\nconst checkin = {\n  checkin_id: nuevoId('CHK'),\n  inscripcion_id: c.inscripcion_id,\n  evento_id: c.evento_id,\n  usuario_id: c.usuario_id,\n  fecha_checkin: ahora(),\n  resultado: c.resultado,\n  detalle: c.detalle,\n};\nconst MENSAJES = {\n  EXITOSO: 'Check-in realizado correctamente.',\n  DUPLICADO: 'El ingreso ya había sido registrado.',\n  RECHAZADO: 'Check-in rechazado.',\n};\nconst exito = c.resultado === 'EXITOSO';\nconst respuesta = {\n  ok: exito,\n  resultado: c.resultado,\n  mensaje: MENSAJES[c.resultado],\n  detalle: c.detalle,\n  checkin: {\n    checkin_id: checkin.checkin_id, inscripcion_id: c.inscripcion_id, evento_id: c.evento_id,\n    fecha_checkin: checkin.fecha_checkin, estado_inscripcion: exito ? 'ASISTIO' : c.estado_inscripcion,\n  },\n  participante: c.nombre_acreditacion,\n  evento: c.evento_nombre,\n};\nif (!exito) respuesta.error = `${MENSAJES[c.resultado]} ${c.detalle}`;\nif (c.resultado === 'DUPLICADO') respuesta.checkin_original = { checkin_id: c.checkin_previo_id, fecha_checkin: c.checkin_previo_fecha };\nlet cuando = checkin.fecha_checkin;\ntry {\n  cuando = new Date(checkin.fecha_checkin).toLocaleString('es-CO', { timeZone: 'America/Bogota', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' });\n} catch (e) {}\nreturn [{ json: {\n  ...checkin,\n  _status: c.status,\n  _respuesta: respuesta,\n  _notificacion: {\n    usuario_id: c.usuario_id, evento_id: c.evento_id, inscripcion_id: c.inscripcion_id,\n    tipo: 'CHECKIN_REGISTRADO', titulo: `Ingreso registrado: ${c.evento_nombre}`,\n    mensaje: `Registramos tu ingreso a ${c.evento_nombre} (${c.evento_lugar}) el ${cuando}. Código de check-in: ${checkin.checkin_id}. ¡Disfruta el evento!`,\n    clave_idempotencia: `CHECKIN_REGISTRADO|${c.inscripcion_id}`,\n  },\n} }];\n"
      },
