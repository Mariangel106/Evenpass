      "position": [
        4420,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// --- Utilidades comunes de EventPass ------------------------------------\nconst ahora = () => new Date().toISOString();\nconst nuevoId = (prefijo) =>\n  prefijo + '-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();\nconst norm = (v) => String(v ?? '').trim();\n// Lee todas las filas de un nodo de Google Sheets ignorando el item vacío que produce \"Always Output Data\".\nconst filas = (nodo) => {\n  try {\n    return $(nodo).all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0);\n  } catch (e) {\n    return [];\n  }\n};\nconst fechaLegible = (iso) => new Date(iso).toLocaleString('es-CO', {\n  timeZone: 'America/Bogota', weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',\n});\n// Fila de la hoja Checkins (EP11). Se registra en todos los intentos, no solo en los exitosos.\nconst registro = (d, resultado, detalle, usuario_id = '') => ({\n  checkin_id: nuevoId('CHK'), inscripcion_id: d.inscripcion_id || '', evento_id: d.evento_id || '', usuario_id,\n  fecha_checkin: ahora(), resultado, detalle,\n});\n// Llega desde el primer IF que falló; se toma el primer motivo en el mismo orden de los IF.\nconst a = $input.first().json;\nconst ins = a.inscripcion || {};\nconst ESTADOS = { LISTA_ESPERA: 'está en lista de espera', CANCELADA: 'fue cancelada' };\nlet status = 409, motivo, error;\nif (!a.inscripcion_existe) {\n  status = 404; motivo = 'INSCRIPCION_INEXISTENTE'; error = `No existe la inscripción ${a.inscripcion_id}.`;\n} else if (!a.evento_existe) {\n  status = 404; motivo = 'EVENTO_INEXISTENTE'; error = `No existe el evento ${a.evento_id}.`;\n} else if (!a.corresponde_evento) {\n  motivo = 'EVENTO_NO_CORRESPONDE'; error = `La inscripción ${a.inscripcion_id} pertenece a otro evento (${ins.evento_id}), no a ${a.evento_id}.`;\n} else if (!a.evento_vigente) {\n  motivo = 'EVENTO_CANCELADO'; error = 'El evento fue cancelado; no se registran ingresos.';\n} else {\n  motivo = 'ESTADO_NO_PERMITIDO';\n  error = `La inscripción ${ESTADOS[ins.estado] || `está en estado ${ins.estado || 'desconocido'}`}; solo pueden ingresar inscripciones CONFIRMADAS.`;\n}\nreturn [{ json: {\n  status,\n  body: { ok: false, resultado: 'RECHAZADO', motivo, error, inscripcion_id: a.inscripcion_id, evento_id: a.evento_id },\n  registro: registro(a, 'RECHAZADO', `${motivo}: ${error}`, ins.usuario_id || ''),\n} }];\n"
      },
      "id": "627da895-77b9-5bd9-ae86-e679ea0025bd",
      "name": "Preparar rechazo",
